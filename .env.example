# Kopieer naar .env (nooit committen) en vul in.
# Docker Compose (docker compose up -d --build) leest dit bestand ook voor variabelen-interpolatie;
# zonder .env gelden de lokale defaults uit docker-compose.yml (DB_HOST/DB_PORT worden daar vast op db/3306 gezet).
APP_ENV=production
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Fine-grained PAT met alleen leesrechten op de teamrepo's
GITHUB_TOKEN=
# Eigen GitHub-gebruikersnaam; wordt uit studentlijsten gefilterd
TEACHER_GITHUB_USERNAME=

# Gedeeld docentenwachtwoord (POC-fallback naast de users-tabel). Leeg = uitgeschakeld.
APP_SHARED_PASSWORD=

SESSION_NAME=glr_dash
SESSION_LIFETIME_MINUTES=480

# Docker Compose: host-poorten (standaard 8080 voor de app, 8081 voor phpMyAdmin)
# APP_PORT=8080
# PMA_PORT=8081
